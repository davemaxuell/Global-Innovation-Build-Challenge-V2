# Python / tooling
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
.env

# Weights and binary checkpoints (GitHub rejects files > 100 MB; publish weights separately)
*.safetensors
*.pt
*.bin

# Large prepared data and historical evidence kept locally
/data/
artifacts/*
# ...except V1's official 13B summary, the reference for the V1-vs-V2 rule (scglm_v2.v1_vs_v2)
!artifacts/phase_evaluation_v1/
artifacts/phase_evaluation_v1/*
!artifacts/phase_evaluation_v1/attempts/
artifacts/phase_evaluation_v1/attempts/*
!artifacts/phase_evaluation_v1/attempts/official_13b/
artifacts/phase_evaluation_v1/attempts/official_13b/*
!artifacts/phase_evaluation_v1/attempts/official_13b/01/
artifacts/phase_evaluation_v1/attempts/official_13b/01/*
!artifacts/phase_evaluation_v1/attempts/official_13b/01/output/
artifacts/phase_evaluation_v1/attempts/official_13b/01/output/*
!artifacts/phase_evaluation_v1/attempts/official_13b/01/output/summary.json
v2/data/*
!v2/data/rich_v1/
v2/data/rich_v1/*
!v2/data/rich_v1/manifest.json
!v2/data/rich_v1/diversity_report.json
!v2/data/rich_v1/targeted/
v2/data/rich_v1/targeted/*
!v2/data/rich_v1/targeted/classifier.json
!v2/data/rich_v1/targeted/selected_examples.json
!v2/data/rich_v1/tokenizer_study/
v2/data/rich_v1/tokenizer_study/*
!v2/data/rich_v1/tokenizer_study/decision.json
!v2/data/rich_v1/benchmarks/
v2/data/rich_v1/benchmarks/*
!v2/data/rich_v1/benchmarks/report.json
!v2/data/rich_v1/downloads/
v2/data/rich_v1/downloads/*
!v2/data/rich_v1/downloads/plan.json
!v2/data/task_tune_v1/
v2/data/task_tune_v1/*
!v2/data/task_tune_v1/report.json
!v2/data/task_tune_full_v1/
v2/data/task_tune_full_v1/*
!v2/data/task_tune_full_v1/report.json

# V1 runs: keep only the small run records
runs/*
!runs/*/
runs/*/*
!runs/*/run.json
!runs/*/status.json

# V2 runs: full per-step logs are too large; events_summary.jsonl is committed instead
v2/runs/*/events.jsonl
v2/runs/*/checkpoints/

# Per-sample harness logs (tens of MB each); results and summaries are committed
**/harness/**/samples_*.jsonl

# Vendored dependencies (see "Setup" in CURRENT_PIPELINE.md) and local-only files
vendor/
archive/pre_reorg_2026-10-01/
docs/references/*.pdf

# Not part of the public competition repository (kept locally on the training server):
# internal notes and drafts, V1-era history, retired code, V1 checkpoint metadata, raw logs.
/AGENTS.md
/COMPETITION_BRIEF.md
/POST_TRAINING_ELIGIBILITY.md
/RUN_STATUS.md
/v2/submission/DEVPOST_DRAFT.md
/v2/submission/README_V2_SECTION.md
/v2/reports/CPU_PREP_*.md
/archive/
/docs/history/
/reports/
/checkpoints/best_sft/
/checkpoints/competition_base/
